# Select one adapter: jobvision, jobinja, irantalent, glassdoor
JOB_PLATFORM=jobvision

# Safety mode: dry-run, review, automatic
APPLICATION_MODE=dry-run

# Matching policy (comma-separated, case-insensitive)
# Technologies control matching. Search keywords control JobVision discovery.
JOB_TECHNOLOGIES=react,next.js,typescript,vue
JOB_SEARCH_KEYWORDS=react,next.js,typescript,vue,frontend,فرانت‌اند
JOB_ACCEPTED_SENIORITIES=mid,senior
JOB_ALLOW_NATIVE=false
JOB_ALLOW_FULLSTACK=true
JOB_BACKEND_TECHNOLOGIES=node.js,python,django,.net,java,php,laravel,go,ruby
JOB_MAX_FULLSTACK_BACKEND_TECHNOLOGIES=1
JOB_ONSITE_CITIES=tehran
JOB_ALLOW_REMOTE_EVERYWHERE=true
MINIMUM_PROFILE_COMPLETION=80

# Search/runtime limits
JOB_PAGE_SIZE=30
JOB_MAX_PAGES=10
REQUEST_DELAY_MS=500
DATABASE_PATH=data/applications.sqlite
REPORT_DIRECTORY=reports
REPORT_TIMEZONE=Asia/Tehran

# JobVision token authentication
JOBVISION_ACCESS_TOKEN=
JOBVISION_CLIENT_ID=
JOBVISION_BASE_URL=https://candidateapi.jobvision.ir
JOBVISION_WEB_APP_VERSION=19.0.153
jobCategoryUrlTitle= #check jobTitles.json for more jobCategoryUrlTitle values
